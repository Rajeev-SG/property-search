{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@property-search/crawl": ["packages/crawl/src/index.ts"],
      "@property-search/domain": ["packages/domain/src/index.ts"],
      "@property-search/harness": ["packages/harness/src/index.ts"]
    },
    "types": ["node"]
  }
}
