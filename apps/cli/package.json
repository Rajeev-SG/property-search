{
  "name": "@property-search/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx ./src/index.ts",
    "doctor": "node --import tsx ./src/index.ts doctor",
    "plans": "node --import tsx ./src/index.ts plans",
    "providers": "node --import tsx ./src/index.ts providers",
    "validate-fixture": "node --import tsx ./src/index.ts validate-fixture",
    "db:migrate": "node --import tsx ./src/index.ts db migrate",
    "db:status": "node --import tsx ./src/index.ts db status",
    "db:verify": "node --import tsx ./src/index.ts db verify",
    "artifacts:smoke": "node --import tsx ./src/index.ts artifacts smoke",
    "sources:ingest": "node --import tsx ./src/index.ts sources ingest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@property-search/crawl": "workspace:*",
    "@property-search/harness": "workspace:*",
    "commander": "14.0.3"
  }
}
